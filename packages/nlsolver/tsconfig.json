{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "types": ["node", "jest"],
        "declaration": true,
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    }
}
